--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-macos, x86_64-macos ]
install-name:    '/System/Library/Frameworks/Foundation.framework/Foundation'
current-version: 1
exports:
  - targets:         [ arm64-macos, x86_64-macos ]
    symbols:         [ _NSLog, _NSTemporaryDirectory ]
    objc-classes:    [ NSProcessInfo, NSURL, NSFileManager, NSMutableArray, NSMutableDictionary, NSMutableString, NSNumber, NSString ]
