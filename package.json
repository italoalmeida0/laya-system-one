{
  "name": "laya-system-one",
  "version": "1.1.0-alpha.1",
  "description": "Self-contained System 1 decision engine: multilingual INT8 transformer served by a zero-dependency native binary (or the bundled pure-Rust WASM engine). TypeSafe Jev wire-compatible (/v1/systemone). Runs offline in Node.js, Bun and browsers.",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "type": "module",
  "bin": {
    "laya-system-one": "./bin/cli.js"
  },
  "files": [
    "bin/cli.js",
    "bin/postinstall.js",
    "src/",
    "models/rl_agent_config.json",
    "models/tokenizer.json",
    "models/tokenizer_config.json",
    "models/model.manifest.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node ./bin/cli.js",
    "test": "npm run test:unit && npm run test:packaging",
    "test:unit": "node ./tools/run-tests.js tests/unit",
    "test:integration": "node ./tools/run-tests.js tests/integration",
    "test:e2e": "node ./tools/run-tests.js tests/e2e",
    "test:packaging": "node ./tools/run-tests.js tests/packaging",
    "test:all": "npm run lint && npm run test:unit && npm run test:packaging && npm run test:integration && npm run test:e2e",
    "lint": "node ./tools/lint.js",
    "bundle": "node ./tools/make-bundle.js",
    "model:chunks": "node ./tools/model-chunks.js build --chunk-mb 24 --model-version $npm_package_version",
    "model:assemble": "node ./tools/model-chunks.js assemble",
    "model:verify": "node ./tools/model-chunks.js verify",
    "model:publish": "node ./tools/model-chunks.js publish",
    "model:acquire": "node ./tools/acquire-model.js",
    "postinstall": "node ./bin/postinstall.js",
    "prepublishOnly": "node ./tools/preflight-publish.js",
    "tokenizer:diff": "node ./tools/tokenizer-diff.js",
    "bench": "node ./tools/bench.js",
    "bench:wasm": "node ./tools/bench.js --backend wasm",
    "pkgs:build": "node ./tools/build-platform-packages.js build",
    "pkgs:pack": "node ./tools/build-platform-packages.js pack",
    "pkgs:list": "node ./tools/build-platform-packages.js list",
    "publish:all": "node ./tools/publish-all.js",
    "test:rehearsal": "node ./tools/install-rehearsal.js",
    "test:rehearsal:all": "node ./tools/install-rehearsal.js --all",
    "check": "node ./tools/local-check.js",
    "check:quick": "node ./tools/local-check.js --quick",
    "quick:check": "node ./tools/quick-check.js",
    "preflight": "node ./tools/preflight-publish.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/italoalmeida0/laya-system-one.git"
  },
  "keywords": [
    "laya",
    "system-one",
    "decision-engine",
    "jev",
    "typesafe",
    "inference",
    "wasm",
    "native",
    "multilingual",
    "classifier",
    "triage",
    "guardrails"
  ],
  "author": "Italo Almeida <https://github.com/italoalmeida0>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/italoalmeida0/laya-system-one/issues"
  },
  "homepage": "https://github.com/italoalmeida0/laya-system-one#readme",
  "dependencies": {},
  "optionalDependencies": {
    "@sys-one/laya-serve-darwin-arm64": "1.1.0-alpha.1",
    "@sys-one/laya-serve-darwin-x64": "1.1.0-alpha.1",
    "@sys-one/laya-serve-win32-x64": "1.1.0-alpha.1",
    "@sys-one/laya-serve-win32-arm64": "1.1.0-alpha.1",
    "@sys-one/laya-serve-linux-x64": "1.1.0-alpha.1",
    "@sys-one/laya-serve-linux-arm64": "1.1.0-alpha.1",
    "@sys-one/laya-serve-universal": "1.1.0-alpha.1",
    "@sys-one/laya-model-chunk-00": "1.1.0-alpha.1",
    "@sys-one/laya-model-chunk-01": "1.1.0-alpha.1",
    "@sys-one/laya-model-chunk-02": "1.1.0-alpha.1",
    "@sys-one/laya-model-chunk-03": "1.1.0-alpha.1",
    "@sys-one/laya-model-chunk-04": "1.1.0-alpha.1",
    "@sys-one/laya-model-chunk-05": "1.1.0-alpha.1",
    "@sys-one/laya-model-chunk-06": "1.1.0-alpha.1",
    "@sys-one/laya-model-chunk-07": "1.1.0-alpha.1",
    "@sys-one/laya-model-chunk-08": "1.1.0-alpha.1",
    "@sys-one/laya-model-chunk-09": "1.1.0-alpha.1",
    "@sys-one/laya-model-chunk-10": "1.1.0-alpha.1",
    "@sys-one/laya-model-chunk-11": "1.1.0-alpha.1",
    "@sys-one/laya-model-chunk-12": "1.1.0-alpha.1"
  }
}
