{
  "name": "laya-system-one",
  "version": "1.1.0",
  "description": "Self-contained System 1 decision engine: multilingual INT8 transformer served by a zero-dependency native binary (or the bundled pure-Rust WASM engine). TypeSafe Jev wire-compatible (/v1/systemone). Runs offline in Node.js, Bun and browsers.",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "type": "module",
  "bin": {
    "laya-system-one": "./bin/cli.js"
  },
  "files": [
    "bin/cli.js",
    "bin/postinstall.js",
    "dist/bin/win32-x64/",
    "dist/bin/win32-arm64/",
    "dist/bin/linux-x64/",
    "dist/bin/linux-x64-musl/laya-serve.bundle",
    "dist/bin/linux-arm64/",
    "dist/bin/linux-arm64-musl/laya-serve.bundle",
    "dist/bin/darwin-x64/",
    "dist/bin/darwin-arm64/",
    "src/",
    "models/rl_agent_config.json",
    "models/tokenizer.json",
    "models/tokenizer_config.json",
    "models/model.manifest.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node ./bin/cli.js",
    "test": "npm run test:unit && npm run test:packaging",
    "test:unit": "node ./tools/run-tests.js tests/unit",
    "test:integration": "node ./tools/run-tests.js tests/integration",
    "test:e2e": "node ./tools/run-tests.js tests/e2e",
    "test:packaging": "node ./tools/run-tests.js tests/packaging",
    "test:install": "node ./tools/run-tests.js tests/fresh-install",
    "test:all": "npm run lint && npm run test:unit && npm run test:packaging && npm run test:integration && npm run test:e2e",
    "smoke": "node ./tools/smoke.js",
    "lint": "node ./tools/lint.js",
    "compare": "node ./tools/compare.js",
    "compare:all": "node ./tools/compare-all.js",
    "bundle": "node ./tools/make-bundle.js",
    "model:chunks": "node ./tools/model-chunks.js build",
    "model:assemble": "node ./tools/model-chunks.js assemble",
    "model:verify": "node ./tools/model-chunks.js verify",
    "model:publish": "node ./tools/model-chunks.js publish",
    "model:acquire": "node ./tools/acquire-model.js",
    "model:test-registry": "node ./tools/model-chunks.js fetch",
    "postinstall": "node ./bin/postinstall.js",
    "prepublishOnly": "npm run lint && npm run test:unit && npm run test:packaging",
    "tokenizer:diff": "node ./tools/tokenizer-diff.js",
    "bench": "node ./tools/bench.js",
    "bench:wasm": "node ./tools/bench.js --backend wasm",
    "test:bun": "bun ./tests/bun/smoke.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/italoalmeida0/laya-system-one.git"
  },
  "keywords": [
    "laya",
    "system-one",
    "decision-engine",
    "jev",
    "typesafe",
    "inference",
    "wasm",
    "native",
    "multilingual",
    "classifier",
    "triage",
    "guardrails"
  ],
  "author": "Italo Almeida <https://github.com/italoalmeida0>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/italoalmeida0/laya-system-one/issues"
  },
  "homepage": "https://github.com/italoalmeida0/laya-system-one#readme",
  "dependencies": {}
}
